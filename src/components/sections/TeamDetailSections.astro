---
import { render } from 'astro:content';
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import Email from '../Email.astro';
import CtaButton from '../CtaButton.astro';
import { defaultLocale, l, type Locale } from '../../i18n/languages';
import { pageT } from '../../i18n/pages';
import { useTranslations } from '../../i18n/ui';
import { fixturesLabels } from '../../i18n/fixtures';
import { leagueLabel, trainingLabel, type LocalizedTeam } from '../../i18n/content';
import { buildFixtures, fixturesQuery } from '../../lib/fixturesBuild';
import { gamesList, leagueTable } from '../../lib/fixturesView';

interface Props {
  team: LocalizedTeam;
}
const { team } = Astro.props;
const { Content } = await render(team.bodyEntry);
const d = team.data;
const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = pageT('teamDetail', lang);
const ui = useTranslations(lang);
const fx = fixturesLabels(lang);

const fixtures = await buildFixtures();
const query = await fixturesQuery();
const f = fixtures.teams[team.slug];
const telHref = (p: string) => `tel:${p.replace(/[^\d+]/g, '').replace(/^0/, '+49')}`;
---
<PageHeader title={d.name} kicker={t.back} kickerHref={l(lang, '/mannschaften')}>
  {/* Mannschaften mit eigener Identität zeigen ihr Wappen und verlinken ihre eigene Website. */}
  <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-5">
    {d.crest && (
      <img src={d.crest} alt={`${t.crest} ${d.name}`} width="96" height="96" class="h-20 w-20 shrink-0 object-contain sm:h-24 sm:w-24" />
    )}
    <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
      <p class="text-lg font-semibold">{leagueLabel(d.league, lang)}</p>
      {d.website && (
        <a href={d.website} rel="noopener" target="_blank" class="group inline-flex min-h-11 items-center gap-2 rounded-full px-5 text-[15px] font-semibold ring-1 ring-ink transition-colors duration-200 hover:bg-ink hover:text-paper">
          {t.ownSite}
          <span class="text-ink-soft group-hover:text-paper" dir="ltr">· {new URL(d.website).host.replace(/^www\./, '')}</span>
          <Icon name="external" size={16} />
        </a>
      )}
    </div>
  </div>
</PageHeader>

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <figure class="reveal">
    <div class="overflow-hidden rounded-sm bg-ink">
      <img src={d.image} alt={d.name} width="1600" height="900" fetchpriority="high" class="aspect-[16/9] w-full object-cover" style={`object-position: 50% ${d.imageFocus}%`} />
    </div>
  </figure>
</section>

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
  <div class="grid gap-14 lg:grid-cols-12 lg:gap-12">
    <!-- Steckbrief -->
    <div class="lg:col-span-4">
      <div class="prose-club text-lg leading-relaxed text-ink-soft">
        <Content />
      </div>
      <dl class="mt-10 border-t border-ink">
        <div class="border-b border-line py-5">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.training}</dt>
          {d.training.map((slot) => <dd class="mt-1.5 font-semibold">{trainingLabel(slot, lang)}</dd>)}
        </div>
        <div class="border-b border-line py-5">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.platz}</dt>
          <dd class="mt-1.5 font-semibold">{d.ground}</dd>
        </div>
        {d.staff.map((person) => (
          <div class="border-b border-line py-5">
            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.roles[person.role]}</dt>
            <dd class="mt-1.5 font-semibold">{person.name}</dd>
            {person.phone && (
              <dd class="mt-1"><a href={telHref(person.phone)} class="nums inline-flex min-h-11 items-center gap-2 text-club hover:text-club-deep"><Icon name="phone" size={16} />{person.phone}</a></dd>
            )}
          </div>
        ))}
        <div class="border-b border-line py-5">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.kontakt}</dt>
          <dd class="mt-1"><Email address={d.contact} class="inline-flex min-h-11 items-center gap-2 break-all text-club hover:text-club-deep"><Icon name="mail" size={16} /></Email></dd>
        </div>
      </dl>
      <CtaButton href={l(lang, '/probetraining')} class="mt-8">{ui.trialCta}</CtaButton>
    </div>

    <!-- Spielplan und Tabelle -->
    <div class="lg:col-span-8">
      {d.fussballDeTeamId ? (
        <>
          <div class="reveal">
            <div class="flex items-end justify-between gap-4">
              <h2 class="display text-4xl sm:text-5xl">{t.spielplan}</h2>
            </div>
            <div class="mt-6" data-fixtures="games" data-team={team.slug} data-query={query} data-built-at={fixtures.fetchedAt} data-labels={JSON.stringify(fx)} set:html={gamesList(f?.games ?? null, fx)} />
          </div>
          <div class="reveal mt-16">
            <div class="flex items-end justify-between gap-4">
              <h2 class="display text-4xl sm:text-5xl">{t.tabelle}</h2>
              {f?.table?.season && <p class="nums text-sm text-ink-soft">{t.saison} {f.table.season}</p>}
            </div>
            <div class="mt-6" data-fixtures="table" data-team={team.slug} data-query={query} data-built-at={fixtures.fetchedAt} data-labels={JSON.stringify(fx)} set:html={leagueTable(f?.table ?? null, fx)} />
          </div>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-4 text-xs text-ink-soft">
            <span>{fx.source}</span>
            <a href={f?.url ?? `https://www.fussball.de/mannschaft/-/team-id/${d.fussballDeTeamId}`} rel="noopener" target="_blank" class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-club hover:text-club-deep">{t.onFussballDe} <Icon name="external" size={16} /></a>
          </div>
        </>
      ) : (
        <div class="reveal border-y border-ink py-10">
          <p class="display text-4xl sm:text-5xl">{trainingLabel(d.training[0] ?? { day: 'Dienstag', from: '18:00', to: '19:30' }, lang)}</p>
          <p class="mt-4 max-w-lg text-lg leading-relaxed text-ink-soft">{t.noLeague}</p>
        </div>
      )}
    </div>
  </div>
</section>

{d.gallery.length > 0 && (
  <section class="border-t border-line bg-card">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="reveal flex items-end justify-between gap-4">
        <h2 class="display text-4xl sm:text-5xl">{t.fotos}</h2>
        {d.gallery.length > 1 && (
          <div class="hidden gap-2 md:flex">
            <button data-carousel-prev class="flex h-11 w-11 items-center justify-center rounded-full ring-1 ring-line transition-colors hover:bg-ink hover:text-paper" aria-label={t.zurueck}><Icon name="arrow" size={18} class="rotate-180" /></button>
            <button data-carousel-next class="flex h-11 w-11 items-center justify-center rounded-full ring-1 ring-line transition-colors hover:bg-ink hover:text-paper" aria-label={t.weiter}><Icon name="arrow" size={18} /></button>
          </div>
        )}
      </div>
      <div data-carousel class="no-scrollbar reveal -mx-4 mt-8 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
        {d.gallery.map((g) => (
          <figure class="w-[85%] shrink-0 snap-start sm:w-[60%] lg:w-[48%]">
            <div class="overflow-hidden rounded-sm bg-ink">
              <img src={g.src} alt={g.alt} loading="lazy" class="aspect-[3/2] w-full object-cover" />
            </div>
            <figcaption class="mt-3 text-sm text-ink-soft">{g.alt}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  import '../../scripts/fixturesLive';
  const track = document.querySelector('[data-carousel]') as HTMLElement | null;
  const rtl = document.documentElement.dir === 'rtl' ? -1 : 1;
  const step = () => ((track?.querySelector('figure')?.clientWidth ?? 400) + 16) * rtl;
  document.querySelector('[data-carousel-prev]')?.addEventListener('click', () => track?.scrollBy({ left: -step(), behavior: 'smooth' }));
  document.querySelector('[data-carousel-next]')?.addEventListener('click', () => track?.scrollBy({ left: step(), behavior: 'smooth' }));
</script>
