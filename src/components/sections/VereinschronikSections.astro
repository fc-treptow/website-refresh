---
import PageHeader from '../PageHeader.astro';
import { defaultLocale, type Locale } from '../../i18n/languages';
import { pageT } from '../../i18n/pages';

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = pageT('vereinschronik', lang);

const images: Record<string, string> = {
  '1925': '/images/chronik-1925.jpg',
  '1932': '/images/chronik-1932.jpg',
  '1938': '/images/chronik-1938.png',
  '1950': '/images/chronik-1950.jpg',
  '1978': '/images/chronik-1974.jpg',
  '1990': '/images/chronik-1990.jpg',
  '1994': '/images/chronik-lok.png',
  '1996': '/images/crest.png',
};
---
<PageHeader title={t.h1} intro={t.intro} />

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <ol>
    {t.timeline.map((item: any) => (
      <li class="reveal grid gap-4 border-b border-line py-10 sm:grid-cols-[10rem_1fr] sm:gap-10 lg:grid-cols-[16rem_1fr_6rem] lg:py-14">
        <p class="display nums text-6xl text-club lg:text-7xl">{item.year}</p>
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold tracking-tight">{item.title}</h2>
          <p class="mt-3 font-serif text-lg leading-relaxed text-ink-soft">{item.text}</p>
        </div>
        {images[item.year] && (
          <img src={images[item.year]} alt="" width="96" height="96" loading="lazy" class="hidden h-20 w-20 object-contain mix-blend-multiply lg:block lg:justify-self-end" />
        )}
      </li>
    ))}
  </ol>
</section>
