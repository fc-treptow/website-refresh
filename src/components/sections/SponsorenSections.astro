---
import { getCollection } from 'astro:content';
import PageHeader from '../PageHeader.astro';
import CtaButton from '../CtaButton.astro';
import { defaultLocale, type Locale } from '../../i18n/languages';
import { pageT } from '../../i18n/pages';
import { club } from '../../data/club';
import { emailDisplay } from '../../lib/email';

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = pageT('sponsoren', lang);
const sponsors = (await getCollection('sponsors')).sort((a, b) => a.data.order - b.data.order);
---
<PageHeader title={t.h1} intro={t.intro} />

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <ul class="stagger grid grid-cols-1 gap-px bg-line sm:grid-cols-2 lg:grid-cols-4">
    {sponsors.map((s) => {
      const Tag = s.data.url ? 'a' : 'div';
      return (
        <li class="bg-paper">
          <Tag {...(s.data.url ? { href: s.data.url, rel: 'noopener', target: '_blank' } : {})} class="group flex h-full flex-col justify-between gap-10 p-8">
            <div class="flex h-20 items-center">
              {s.data.logo ? (
                <img src={s.data.logo} alt={s.data.name} loading="lazy" class="max-h-16 w-auto max-w-[70%] object-contain mix-blend-multiply" />
              ) : (
                <span class="display text-5xl">{s.data.name}</span>
              )}
            </div>
            <div>
              {s.data.tier === 'Hauptsponsor' && <p class="text-xs font-semibold uppercase tracking-[0.14em] text-club">{t.hauptsponsor}</p>}
              <p class="mt-1 font-semibold">{s.data.name}</p>
            </div>
          </Tag>
        </li>
      );
    })}
  </ul>
</section>

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
  <div class="reveal grid gap-8 border-t border-ink pt-10 lg:grid-cols-12">
    <h2 class="display text-5xl sm:text-6xl lg:col-span-5">{t.ctaTitle}</h2>
    <div class="lg:col-span-7">
      <p class="max-w-xl text-lg leading-relaxed text-ink-soft">{t.ctaText}</p>
      <CtaButton email={club.boardEmail} class="mt-8"><span data-email-text>{emailDisplay(club.boardEmail)}</span></CtaButton>
    </div>
  </div>
</section>
