---
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import { defaultLocale, l, type Locale } from '../../i18n/languages';
import { pageT } from '../../i18n/pages';
import { getTeams, leagueLabel, trainingLabel } from '../../i18n/content';

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = pageT('mannschaftenIndex', lang);
const teams = await getTeams(lang);
---
<PageHeader title={t.h1} intro={t.intro} />

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <ol class="grid gap-x-8 gap-y-16 md:grid-cols-2">
    {teams.map((team) => (
      <li class="reveal">
        <a href={l(lang, `/mannschaften/${team.slug}`)} class="group block">
          <div class="overflow-hidden rounded-sm bg-ink">
            <img src={team.data.image} alt={team.data.name} width="1200" height="750" loading="lazy" class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-(--ease-club) group-hover:scale-[1.02]" style={`object-position: 50% ${team.data.imageFocus}%`} />
          </div>
          <div class="mt-5 flex items-start justify-between gap-4">
            <div class="min-w-0">
              <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-club">
                {team.data.crest && <img src={team.data.crest} alt="" width="24" height="24" loading="lazy" class="h-6 w-6 object-contain" />}
                {team.data.shortName}
              </p>
              <h2 class="display mt-1.5 text-4xl sm:text-5xl">{team.data.name}</h2>
              <p class="mt-2 font-semibold">{leagueLabel(team.data.league, lang)}</p>
              <p class="mt-1 text-sm text-ink-soft">{t.trainingLabel}: {team.data.training.map((s) => trainingLabel(s, lang)).join(', ')}</p>
            </div>
            <span class="mt-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-full ring-1 ring-line transition-colors duration-200 group-hover:bg-ink group-hover:text-paper">
              <Icon name="arrow" size={18} />
            </span>
          </div>
        </a>
      </li>
    ))}
  </ol>
</section>
