---
import { render } from 'astro:content';
import ShareBar from '../ShareBar.astro';
import Icon from '../Icon.astro';
import { newsImage } from '../../lib/newsImages';
import { defaultLocale, bcp47, l, type Locale } from '../../i18n/languages';
import { pageT } from '../../i18n/pages';
import type { LocalizedNews } from '../../i18n/content';

interface Props {
  post: LocalizedNews;
}
const { post } = Astro.props;
const { Content } = await render(post);
const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = pageT('newsDetail', lang);
const cover = post.data.image ? newsImage(post.data.image) : null;
const photos = post.data.gallery.map((g) => ({ ...g, img: newsImage(g.src) }));
const n = photos.length;
const fmt = (d: Date) => d.toLocaleDateString(bcp47[lang], { day: 'numeric', month: 'long', year: 'numeric' });
---
<article class="mx-auto max-w-7xl px-4 pb-8 pt-8 sm:px-6 sm:pt-10 lg:px-8 lg:pt-14">
  <div class="mx-auto max-w-3xl">
    <a href={l(lang, '/news')} class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink-soft transition-colors hover:text-ink">{t.back}</a>
    <div class="mt-6 flex items-center justify-between gap-4">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft"><span class="text-club">{post.data.tag}</span> · <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt(post.data.date)}</time></p>
      <ShareBar title={post.data.title} />
    </div>
    <h1 class="mt-4 text-4xl font-bold leading-[1.1] tracking-tight text-balance sm:text-5xl">{post.data.title}</h1>
    <p class="mt-5 text-xl leading-relaxed text-ink-soft">{post.data.teaser}</p>
  </div>
  {post.data.image && (
    <div class="mx-auto mt-10 max-w-5xl overflow-hidden rounded-sm bg-ink">
      <img src={cover!.full} srcset={cover!.srcset} sizes="(min-width: 64rem) 64rem, 100vw" width={cover!.width} height={cover!.height} alt={post.data.imageAlt ?? ''} class="aspect-[16/9] w-full object-cover" fetchpriority="high" />
    </div>
  )}
  <div lang={post.isFallback ? 'de' : undefined} class="prose-club mx-auto mt-10 max-w-3xl text-lg leading-relaxed">
    <Content />
  </div>

  {n > 0 && (
    <section class="mx-auto mt-14 max-w-5xl border-t border-ink pt-8" aria-labelledby="news-fotos">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="news-fotos" class="display text-4xl sm:text-5xl">{t.photos}</h2>
        <p class="text-sm text-ink-soft">{t.photoCount.replace('{n}', String(n))}</p>
      </div>
      <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4" data-gallery>
        {photos.map((p, i) => (
          <li>
            <figure>
              <a
                href={p.img.full}
                data-index={i}
                data-full={p.img.full}
                data-alt={p.alt ?? ''}
                data-caption={p.caption ?? ''}
                class="group block overflow-hidden rounded-sm bg-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-club"
                aria-label={`${t.openPhoto}: ${p.caption || p.alt || t.photoOf.replace('{i}', String(i + 1)).replace('{n}', String(n))}`}
              >
                <img src={p.img.src} srcset={p.img.srcset} sizes="(min-width: 64rem) 21rem, (min-width: 40rem) 33vw, 50vw" width={p.img.width} height={p.img.height} alt={p.alt ?? ''} loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover transition-transform duration-700 ease-(--ease-club) group-hover:scale-[1.03]" />
              </a>
              {p.caption && <figcaption class="mt-2 text-sm leading-snug text-ink-soft">{p.caption}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )}
</article>

{n > 0 && (
  <dialog data-lightbox aria-label={t.photos} class="m-0 h-dvh max-h-none w-screen max-w-none bg-ink p-0 text-paper backdrop:bg-ink/90">
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <p class="nums text-sm text-paper/70" data-lightbox-count aria-live="polite"></p>
        <button type="button" data-lightbox-close class="flex h-11 w-11 items-center justify-center rounded-full ring-1 ring-paper/30 transition-colors hover:bg-paper hover:text-ink" aria-label={t.closePhoto}><Icon name="close" size={18} /></button>
      </div>
      <div class="relative flex min-h-0 flex-1 items-center justify-center px-2 sm:px-16">
        <img data-lightbox-img alt="" class="max-h-full max-w-full object-contain" />
        {n > 1 && (
          <>
            <button type="button" data-lightbox-prev class="absolute start-2 top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-ink/60 ring-1 ring-paper/30 transition-colors hover:bg-paper hover:text-ink sm:flex sm:start-4" aria-label={t.prevPhoto}><Icon name="arrow" size={18} class="rotate-180" /></button>
            <button type="button" data-lightbox-next class="absolute end-2 top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-ink/60 ring-1 ring-paper/30 transition-colors hover:bg-paper hover:text-ink sm:flex sm:end-4" aria-label={t.nextPhoto}><Icon name="arrow" size={18} /></button>
          </>
        )}
      </div>
      <p class="min-h-14 px-4 py-4 text-center text-sm leading-snug text-paper/85 sm:px-6" data-lightbox-caption></p>
    </div>
  </dialog>
)}

<script define:vars={{ photoOf: t.photoOf }}>
  // Großansicht der Fotogalerie mit dem eingebauten <dialog> des Browsers, ohne fremdes Skript.
  // Ohne JavaScript öffnen die Vorschaubilder einfach das große Foto.
  const dialog = document.querySelector('[data-lightbox]');
  const links = [...document.querySelectorAll('[data-gallery] a[data-index]')];
  if (dialog && links.length) {
    const img = dialog.querySelector('[data-lightbox-img]');
    const caption = dialog.querySelector('[data-lightbox-caption]');
    const count = dialog.querySelector('[data-lightbox-count]');
    const rtl = document.documentElement.dir === 'rtl';
    let current = 0;
    const show = (i) => {
      current = (i + links.length) % links.length;
      const a = links[current];
      img.src = a.dataset.full;
      img.alt = a.dataset.alt;
      caption.textContent = a.dataset.caption || a.dataset.alt;
      count.textContent = photoOf.replace('{i}', String(current + 1)).replace('{n}', String(links.length));
      // Nächstes Foto schon laden, damit das Blättern nicht hakt
      new Image().src = links[(current + 1) % links.length].dataset.full;
    };
    links.forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(Number(a.dataset.index));
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lightbox-close]').addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + (rtl ? -1 : 1));
      if (e.key === 'ArrowLeft') show(current + (rtl ? 1 : -1));
    });
    // Klick neben das Foto schließt
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === img.parentElement) dialog.close();
    });
    // Wischen auf dem Handy
    let startX = null;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (startX === null || links.length < 2) return;
      const dx = e.changedTouches[0].clientX - startX;
      startX = null;
      if (Math.abs(dx) < 40) return;
      show(current + ((dx < 0) !== rtl ? 1 : -1));
    });
    dialog.addEventListener('close', () => links[current]?.focus());
  }
</script>
