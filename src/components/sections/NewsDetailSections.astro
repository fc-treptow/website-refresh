---
import { render } from 'astro:content';
import ShareBar from '../ShareBar.astro';
import PhotoGrid from '../PhotoGrid.astro';
import Lightbox from '../Lightbox.astro';
import { newsImage } from '../../lib/newsImages';
import { defaultLocale, bcp47, l, type Locale } from '../../i18n/languages';
import { pageT } from '../../i18n/pages';
import type { LocalizedNews } from '../../i18n/content';

interface Props {
  post: LocalizedNews;
}
const { post } = Astro.props;
const { Content } = await render(post);
const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = pageT('newsDetail', lang);
const cover = post.data.image ? newsImage(post.data.image) : null;
const n = post.data.gallery.length;
// Strukturierte Daten für Suchmaschinen (schema.org NewsArticle)
const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.data.title,
  description: post.data.teaser,
  datePublished: post.data.date.toISOString().slice(0, 10),
  inLanguage: lang,
  mainEntityOfPage: new URL(Astro.url.pathname, site).href,
  image: [post.data.image, ...post.data.gallery.map((g) => g.src)]
    .filter((src): src is string => Boolean(src))
    .map((src) => new URL(newsImage(src).full, site).href),
  publisher: { '@type': 'SportsOrganization', name: 'FC Treptow e.V.', url: site.href },
};
const fmt = (d: Date) => d.toLocaleDateString(bcp47[lang], { day: 'numeric', month: 'long', year: 'numeric' });
---
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<article class="mx-auto max-w-7xl px-4 pb-8 pt-8 sm:px-6 sm:pt-10 lg:px-8 lg:pt-14">
  <div class="mx-auto max-w-3xl">
    <a href={l(lang, '/news')} class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink-soft transition-colors hover:text-ink">{t.back}</a>
    <div class="mt-6 flex items-center justify-between gap-4">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft"><span class="text-club">{post.data.tag}</span> · <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt(post.data.date)}</time></p>
      <ShareBar title={post.data.title} />
    </div>
    <h1 class="mt-4 text-4xl font-bold leading-[1.1] tracking-tight text-balance sm:text-5xl">{post.data.title}</h1>
    <p class="mt-5 text-xl leading-relaxed text-ink-soft">{post.data.teaser}</p>
  </div>
  {post.data.image && (
    <div class="mx-auto mt-10 max-w-5xl overflow-hidden rounded-sm bg-ink">
      <img src={cover!.full} srcset={cover!.srcset} sizes="(min-width: 64rem) 64rem, 100vw" width={cover!.width} height={cover!.height} alt={post.data.imageAlt ?? ''} class="aspect-[16/9] w-full object-cover" fetchpriority="high" />
    </div>
  )}
  <div lang={post.isFallback ? 'de' : undefined} class="prose-club mx-auto mt-10 max-w-3xl text-lg leading-relaxed">
    <Content />
  </div>

  {n > 0 && (
    <section class="mx-auto mt-14 max-w-5xl border-t border-ink pt-8" aria-labelledby="news-fotos">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="news-fotos" class="display text-4xl sm:text-5xl">{t.photos}</h2>
        <p class="text-sm text-ink-soft">{t.photoCount.replace('{n}', String(n))}</p>
      </div>
      <div class="mt-6">
        <PhotoGrid photos={post.data.gallery} />
      </div>
    </section>
  )}
</article>

{n > 0 && <Lightbox count={n} />}
