---
import { getCollection } from 'astro:content';
import PageHeader from '../PageHeader.astro';
import CtaButton from '../CtaButton.astro';
import Icon from '../Icon.astro';
import Email from '../Email.astro';
import { defaultLocale, l, type Locale } from '../../i18n/languages';
import { pageT } from '../../i18n/pages';
import { club } from '../../data/club';

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = pageT('schiedsrichter', lang);

// Obmann aus dem Vorstand (Rolle refereeLead), Team aus der eigenen Sammlung
const lead = (await getCollection('vorstand')).map((e) => e.data).find((m) => m.role === 'refereeLead');
const leadEmail = lead?.email ?? club.email;
const team = (await getCollection('schiedsrichter')).map((e) => e.data).sort((a, b) => a.order - b.order || a.name.localeCompare(b.name, 'de'));
---
<PageHeader title={t.h1} intro={t.intro} />

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <div class="reveal grid gap-10 lg:grid-cols-12 lg:gap-12">
    {lead && (
      <div class="lg:col-span-4">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-club">{t.leadLabel}</p>
        <p class="display mt-3 text-4xl">{lead.name}</p>
        <Email address={leadEmail} class="mt-4 inline-flex min-h-11 items-center gap-2 break-all text-sm text-ink-soft hover:text-ink"><Icon name="mail" size={16} /></Email>
      </div>
    )}
    {team.length > 0 && (
      <div class:list={[lead ? 'lg:col-span-8' : 'lg:col-span-12']}>
        <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.teamHeading}</h2>
        <ul class="mt-4 grid border-t border-ink sm:grid-cols-2 sm:gap-x-10">
          {team.map((m) => (
            <li class="border-b border-line py-5 text-lg font-semibold">{m.name}</li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-section sm:px-6 lg:px-8">
  <div class="reveal grid gap-6 lg:grid-cols-12 lg:gap-12">
    <h2 class="display text-5xl sm:text-6xl lg:col-span-5">{t.becomeHeading}</h2>
    <p class="max-w-2xl text-lg leading-relaxed text-ink-soft lg:col-span-7 lg:pt-2">{t.becomeIntro}</p>
  </div>
  <ul class="stagger mt-12 grid gap-px bg-line md:grid-cols-3">
    {t.points.map((p: { title: string; text: string }) => (
      <li class="bg-paper py-8 md:px-8 md:first:ps-0 md:last:pe-0">
        <h3 class="text-xl font-bold">{p.title}</h3>
        <p class="mt-2 leading-relaxed text-ink-soft">{p.text}</p>
      </li>
    ))}
  </ul>
  <div class="reveal mt-16 flex flex-wrap items-center gap-x-6 gap-y-4 border-t border-ink pt-10">
    <CtaButton email={leadEmail} subject={t.mailSubject}>{t.cta}</CtaButton>
    <p class="text-sm leading-relaxed text-ink-soft">
      {t.notMemberYet} <a href={l(lang, '/mitgliedschaft')} class="font-semibold text-ink underline decoration-line decoration-2 underline-offset-4 hover:decoration-ink">{t.membershipLink}</a>
    </p>
  </div>
</section>
