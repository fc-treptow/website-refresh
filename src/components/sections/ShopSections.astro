---
import PageHeader from '../PageHeader.astro';
import ShopGrid from '../ShopGrid.astro';
import Icon from '../Icon.astro';
import { defaultLocale, l, type Locale } from '../../i18n/languages';
import { pageT } from '../../i18n/pages';
import { useTranslations } from '../../i18n/ui';
import { club } from '../../data/club';

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = pageT('shop', lang);
const ui = useTranslations(lang);
// Spreadshop kennt nur diese Sprachen; Türkisch und Arabisch bekommen Englisch.
const shopLocale: Record<Locale, string> = { de: 'de_DE', en: 'en_GB', tr: 'en_GB', ar: 'en_GB', es: 'es_ES', fr: 'fr_FR' };
const shopHost = new URL(club.shopUrl).host;
---
<PageHeader title={t.h1} intro={t.intro}>
  <p class="mt-4 max-w-xl text-sm text-ink-soft">{ui.shopNote}</p>
</PageHeader>

<!-- Der eigentliche Shop (Spreadshop-Plugin). Lädt erst nach Klick: Zwei-Klick-Lösung. -->
<section id="fanshop" class="mx-auto max-w-7xl scroll-mt-24 px-4 sm:px-6 lg:px-8">
  <div id="shop-gate" class="grid gap-8 rounded-sm bg-ink p-8 text-paper lg:grid-cols-12 lg:items-center lg:p-12">
    <div class="lg:col-span-8">
      <h2 class="display text-4xl sm:text-5xl">{t.loadTitle}</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-paper/75">{t.loadText} <a href={l(lang, '/datenschutz')} class="underline underline-offset-4 hover:text-paper">{t.privacyLink}</a>.</p>
    </div>
    <div class="lg:col-span-4 lg:text-end">
      <button id="shop-load" type="button" class="group inline-flex min-h-12 items-center gap-3 rounded-full bg-club py-1.5 ps-6 pe-1.5 text-[15px] font-semibold text-white transition-[background-color,transform] duration-200 ease-(--ease-club) hover:bg-club-deep active:scale-[0.97]">
        {t.loadButton}
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/15 transition-transform duration-300 group-hover:translate-x-0.5"><Icon name="bag" size={18} /></span>
      </button>
      <p class="mt-3 text-xs text-paper/55">{t.loadHint}</p>
    </div>
  </div>
  <div id="shop" class="hidden min-h-[60dvh]" data-prefix={club.shopUrl} data-host={shopHost} data-shop-name={shopHost.split('.')[0]} data-locale={shopLocale[lang]} data-loading={t.loading}></div>
  <div id="shop-failed" class="hidden border-y border-ink py-10" role="alert">
    <p class="max-w-xl text-lg leading-relaxed">{t.loadFailed}</p>
    <a href={club.shopUrl} rel="noopener" target="_blank" class="mt-5 inline-flex min-h-12 items-center gap-2 font-semibold text-club hover:text-club-deep">{t.loadFailedLink} <Icon name="external" size={16} /></a>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 pt-section sm:px-6 lg:px-8">
  <div class="reveal flex flex-wrap items-end justify-between gap-4">
    <h2 class="display text-4xl sm:text-5xl">{t.allHeading}</h2>
    <p class="text-sm text-ink-soft">{t.pickHint}</p>
  </div>
  <div class="mt-8">
    <ShopGrid />
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-section sm:px-6 lg:px-8">
  <div class="grid gap-14 lg:grid-cols-2 lg:gap-12">
    <div class="reveal">
      <h2 class="display text-4xl sm:text-5xl">{t.designsHeading}</h2>
      <dl class="mt-8 border-t border-ink">
        {t.designs.map((d: any) => (
          <div class="border-b border-line py-5">
            <dt class="text-lg font-semibold">{d.title}</dt>
            <dd class="mt-1 text-ink-soft">{d.text}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="reveal">
      <h2 class="display text-4xl sm:text-5xl">{t.how}</h2>
      <ol class="mt-8 border-t border-ink">
        {t.howItems.map((item: string, i: number) => (
          <li class="flex gap-5 border-b border-line py-5">
            <span class="display nums text-3xl text-club">{i + 1}</span>
            <span class="pt-1 leading-relaxed">{item}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style is:global>
  /* Spreadshop übernimmt die Schrift der Seite; ein paar Ränder anpassen */
  #shop .sprd-header, #shop .sprd-footer { display: none; }
</style>

<script>
  // Zwei-Klick-Einbettung des Spreadshops. Vorher wird nichts von Spreadshirt geladen.
  const gate = document.getElementById('shop-gate');
  const shop = document.getElementById('shop');
  const btn = document.getElementById('shop-load');

  // Artikelkarten (auch von der Startseite) tragen den Produktpfad im Hash
  const startFromHash = () => {
    const h = decodeURIComponent(location.hash.slice(1));
    return h && h !== 'fanshop' ? h : '';
  };

  // Spreadshop meldet Einbettungsfehler (z. B. Domain nicht freigegeben) als abgelehntes Promise.
  // Zur Sicherheit greift zusätzlich ein Zeitlimit: bleibt der Shop leer, kommt der Ausweg.
  const showFailed = () => {
    shop?.classList.add('hidden');
    document.getElementById('shop-failed')?.classList.remove('hidden');
  };
  const isShopError = (v: unknown) => /spread\s?shop/i.test(String((v as any)?.message ?? v ?? ''));
  window.addEventListener('unhandledrejection', (e) => { if (isShopError(e.reason)) showFailed(); });
  window.addEventListener('error', (e) => { if (isShopError(e.message)) showFailed(); });
  let loaded = false;
  function loadShop(startToken: string) {
    if (!shop || loaded) return;
    loaded = true;
    gate?.classList.add('hidden');
    shop.classList.remove('hidden');
    shop.textContent = shop.dataset.loading ?? '';
    (window as any).spread_shop_config = {
      prefix: shop.dataset.prefix,
      shopName: shop.dataset.shopName,
      baseId: 'shop',
      locale: shop.dataset.locale,
      usePushState: false,
      updateMetadata: false,
      ...(startToken ? { startToken } : {}),
    };
    const s = document.createElement('script');
    s.src = `https://${shop.dataset.host?.replace(/\.myspreadshop\.[a-z.]+$/, '.myspreadshop.net')}/js/shopclient.nocache.js`;
    s.async = true;
    s.onerror = showFailed;
    document.body.appendChild(s);
    shop.scrollIntoView({ block: 'start', behavior: 'smooth' });
    setTimeout(() => {
      if (shop.querySelector('*') === null) showFailed();
    }, 15000);
  }

  btn?.addEventListener('click', () => loadShop(startFromHash()));

  // Klick auf eine Artikelkarte: Shop mit diesem Artikel öffnen (nach Freigabe)
  document.querySelectorAll<HTMLAnchorElement>('[data-shop-item]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const token = decodeURIComponent(a.hash.slice(1));
      if (loaded) {
        e.preventDefault();
        (window as any).spread_shop_config = { ...(window as any).spread_shop_config, startToken: token };
        location.hash = a.hash;
        shop?.scrollIntoView({ block: 'start', behavior: 'smooth' });
        return;
      }
      e.preventDefault();
      history.replaceState(null, '', a.hash);
      loadShop(token);
    });
  });

  // Direkt mit Produkt-Hash angekommen (z. B. von der Startseite): Freigabe-Block anzeigen, nicht auto-laden
  if (startFromHash()) gate?.scrollIntoView({ block: 'start' });
</script>
