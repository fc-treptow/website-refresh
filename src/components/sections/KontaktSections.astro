---
import PageHeader from '../PageHeader.astro';
import CtaButton from '../CtaButton.astro';
import Icon from '../Icon.astro';
import Email from '../Email.astro';
import { defaultLocale, l, type Locale } from '../../i18n/languages';
import { pageT } from '../../i18n/pages';
import { club } from '../../data/club';
import { getContacts } from '../../lib/links';

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const contacts = await getContacts();
const t = pageT('kontakt', lang);
---
<PageHeader title={t.h1} intro={t.intro} />

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="reveal lg:col-span-5">
      <dl class="border-t border-ink">
        <div class="border-b border-line py-6">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.email}</dt>
          <dd class="mt-1"><Email address={contacts.email} class="inline-flex min-h-11 items-center text-xl font-semibold text-club hover:text-club-deep" /></dd>
        </div>
        {contacts.phone && (
          <div class="border-b border-line py-6">
            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.telefon}</dt>
            <dd class="mt-1"><a href={contacts.phoneHref} class="nums inline-flex min-h-11 items-center text-xl font-semibold" dir="ltr">{contacts.phone}</a></dd>
          </div>
        )}
        <div class="border-b border-line py-6">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.sportanlage}</dt>
          <dd class="mt-2 text-lg font-semibold leading-snug">{club.ground.name}<br />{club.ground.street}<br />{club.ground.city}</dd>
        </div>
        <div class="border-b border-line py-6">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.training}</dt>
          <dd class="mt-2 text-lg font-semibold">{t.trainingTimes}</dd>
        </div>
      </dl>
      <CtaButton href={club.ground.mapsUrl} external class="mt-8">{t.routeCta}</CtaButton>
      <p class="mt-6 text-sm text-ink-soft"><a href={l(lang, '/vorstand')} class="font-semibold text-club hover:text-club-deep">{t.vorstandLink}</a></p>
    </div>
    <div class="lg:col-span-7">
      <figure class="reveal">
        <div class="overflow-hidden rounded-sm bg-ink">
          <img src="/images/vereinsbuero.jpg" alt={t.imgAlt} width="1200" height="630" loading="lazy" class="aspect-[16/9] w-full object-cover" />
        </div>
      </figure>
      <div class="reveal mt-10">
        <h2 class="display text-4xl">{t.anreise}</h2>
        <ul class="mt-6 border-t border-ink">
          <li class="flex gap-4 border-b border-line py-5"><Icon name="pin" size={22} class="mt-0.5 text-club" /><span class="text-lg">{t.sbahn}</span></li>
          <li class="flex gap-4 border-b border-line py-5"><Icon name="pin" size={22} class="mt-0.5 text-club" /><span class="text-lg">{t.bus}</span></li>
          <li class="flex gap-4 border-b border-line py-5"><Icon name="pin" size={22} class="mt-0.5 text-club" /><span class="text-lg">{t.parken}</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>
