---
import PageHeader from '../PageHeader.astro';
import Email from '../Email.astro';
import { defaultLocale, type Locale } from '../../i18n/languages';
import { pageT } from '../../i18n/pages';
import { club } from '../../data/club';
import { getContacts } from '../../lib/links';

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const contacts = await getContacts();
const t = pageT('impressum', lang);
---
<PageHeader title={t.h1} />

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <dl class="grid max-w-4xl border-t border-ink">
    <div class="grid gap-2 border-b border-line py-6 sm:grid-cols-[16rem_1fr]">
      <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft sm:pt-1">{t.tmg}</dt>
      <dd class="text-lg leading-relaxed"><strong>{t.legalName}</strong><br />{club.ground.street}<br />{club.ground.city}</dd>
    </div>
    <div class="grid gap-2 border-b border-line py-6 sm:grid-cols-[16rem_1fr]">
      <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft sm:pt-1">{t.repHeading}</dt>
      <dd class="text-lg leading-relaxed">{t.rep1}<br />{t.rep2}</dd>
    </div>
    <div class="grid gap-2 border-b border-line py-6 sm:grid-cols-[16rem_1fr]">
      <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft sm:pt-1">{t.contactLabel}</dt>
      <dd class="text-lg leading-relaxed">
        {contacts.phone && <>{t.phoneLabel}: <a href={contacts.phoneHref} class="nums" dir="ltr">{contacts.phone}</a><br /></>}
        {t.emailLabel}: <Email address={contacts.boardEmail} class="text-club hover:text-club-deep" /><br />
        <Email address={contacts.email} class="text-club hover:text-club-deep" />
      </dd>
    </div>
    <div class="grid gap-2 border-b border-line py-6 sm:grid-cols-[16rem_1fr]">
      <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft sm:pt-1">{t.registerHeading}</dt>
      <dd class="text-lg leading-relaxed">{t.court}: {t.courtValue}<br />{t.regNo}: VR14908</dd>
    </div>
  </dl>
</section>
