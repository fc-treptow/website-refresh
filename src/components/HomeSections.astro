---
import { thumbAttrs } from '../lib/newsImages';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import CtaButton from './CtaButton.astro';
import ShopGrid from './ShopGrid.astro';
import { getCollection } from 'astro:content';
import { defaultLocale, bcp47, l, type Locale } from '../i18n/languages';
import { useTranslations } from '../i18n/ui';
import { getNews, getTeams, leagueLabel, trainingLabel } from '../i18n/content';
import { fixturesLabels } from '../i18n/fixtures';
import { getInstagramPosts } from '../lib/instagram';
import { buildFixtures, fixturesQuery } from '../lib/fixturesBuild';
import { gameRow, leagueTable, type Game } from '../lib/fixturesView';
import { club } from '../data/club';
import { readFileSync } from 'node:fs';

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(lang);
const fx = fixturesLabels(lang);

const sponsors = (await getCollection('sponsors')).sort((a, b) => a.data.order - b.data.order);
const teams = await getTeams(lang);
const news = await getNews(lang);
const [lead, ...moreNews] = news;
const { posts: socialPosts, isLive: socialIsLive } = await getInstagramPosts(6);

// Nächstes Spiel je Mannschaft, zeitlich sortiert
const fixtures = await buildFixtures();
const query = await fixturesQuery();
const teamLabels = Object.fromEntries(teams.map((tm) => [tm.slug, tm.data.shortName]));
const leagueTeamList = teams.filter((tm) => tm.data.fussballDeTeamId);
const nextGames = Object.entries(fixtures.teams)
  .map(([slug, f]) => (f.games?.[0] ? { slug, g: f.games[0] as Game } : null))
  .filter((x): x is { slug: string; g: Game } => !!x)
  .sort((a, b) => `${a.g.date}${a.g.time}`.localeCompare(`${b.g.date}${b.g.time}`));

const numerals = ['I', 'II', 'III', 'F'];

// Auftakt-Karussell: das Mannschaftsfoto aus dem CMS, verkleinert von scripts/gen-hero.mjs.
// Fehlt die verkleinerte Fassung (Skript nicht gelaufen oder Foto gerade getauscht), nimmt es das Original.
type HeroManifest = Record<string, { image: string; files: Record<string, string> }>;
let heroManifest: HeroManifest = {};
try {
  heroManifest = JSON.parse(readFileSync(`${process.cwd()}/public/images/hero/manifest.json`, 'utf8'));
} catch {}
const heroSizes = '100vw';
const heroSlides = teams.map((tm) => {
  const resized = heroManifest[tm.slug]?.image === tm.data.image ? heroManifest[tm.slug].files : null;
  return {
    name: tm.data.name,
    shortName: tm.data.shortName,
    league: leagueLabel(tm.data.league, lang),
    href: l(lang, `/mannschaften/${tm.slug}`),
    focus: tm.data.imageFocus,
    src: resized?.['1600'] ?? tm.data.image,
    srcset: resized ? Object.entries(resized).map(([w, f]) => `${f} ${w}w`).join(', ') : undefined,
  };
});
const chronik = [
  { year: '1925', img: '/images/chronik-1925.jpg', label: 'Werksverein Bewag' },
  { year: '1932', img: '/images/chronik-1932.jpg', label: 'SV Bewag Berlin' },
  { year: '1938', img: '/images/chronik-1938.png', label: 'SV Elektra Berlin' },
  { year: '1950', img: '/images/chronik-1950.jpg', label: 'BSG Turbine Bewag' },
  { year: '1974', img: '/images/chronik-1974.jpg', label: 'BSG Turbine Berlin' },
  { year: '1990', img: '/images/chronik-1990.jpg', label: 'SV Turbine Berlin' },
  { year: '1994', img: '/images/crest.png', label: 'FC Treptow e.V.' },
];
const fmt = (d: Date) => d.toLocaleDateString(bcp47[lang], { day: 'numeric', month: 'long', year: 'numeric' });
---

<!-- 1. Auftakt als Plakat: Mannschaftsfoto über die volle Breite, Leitsatz groß darüber -->
<section class="pb-section">
  <!-- Karussell mit dem Mannschaftsfoto jeder Mannschaft aus dem CMS. Ohne JavaScript steht das erste Foto. -->
  <div class="relative isolate h-[min(calc(100svh-8rem),44rem)] min-h-[32rem] overflow-hidden bg-ink text-paper lg:h-[min(calc(100svh-4.5rem),56rem)] lg:min-h-[38rem]" data-hero-carousel role="region" aria-roledescription="carousel" aria-label={t.heroCarouselLabel}>
    <div class="hero-photo absolute inset-0">
      {heroSlides.map((s, i) => (
        <a
          href={s.href}
          class="hero-slide absolute inset-0 block"
          data-hero-slide
          data-active={i === 0 ? 'true' : 'false'}
          aria-roledescription="slide"
          aria-label={`${i + 1} / ${heroSlides.length}: ${s.name}`}
          inert={i !== 0}
        >
          {i === 0 ? (
            <img src={s.src} srcset={s.srcset} sizes={heroSizes} alt={s.name} width="1600" height="1000" fetchpriority="high" class="h-full w-full object-cover" style={`object-position: 50% ${s.focus}%`} />
          ) : (
            <img data-src={s.src} data-srcset={s.srcset} sizes={heroSizes} alt={s.name} width="1600" height="1000" decoding="async" class="h-full w-full object-cover" style={`object-position: 50% ${s.focus}%`} />
          )}
        </a>
      ))}
      <!-- Abdunklung unten, damit der Leitsatz auf jedem Foto lesbar bleibt -->
      <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgb(22_24_29/0.35)_0%,rgb(22_24_29/0)_22%,rgb(22_24_29/0)_35%,rgb(22_24_29/0.55)_65%,rgb(22_24_29/0.9)_100%)]" aria-hidden="true"></div>
      {heroSlides.length > 1 && (
        <>
          <button type="button" data-hero-step="-1" aria-label={t.heroPrev} class="hero-arrow absolute start-3 top-1/3 z-10 grid size-11 place-items-center rounded-full bg-paper/90 text-ink shadow-sm transition hover:bg-paper" hidden>
            <span class="rotate-180"><Icon name="arrow" size={18} /></span>
          </button>
          <button type="button" data-hero-step="1" aria-label={t.heroNext} class="hero-arrow absolute end-3 top-1/3 z-10 grid size-11 place-items-center rounded-full bg-paper/90 text-ink shadow-sm transition hover:bg-paper" hidden>
            <span><Icon name="arrow" size={18} /></span>
          </button>
        </>
      )}
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10">
      <div class="mx-auto grid max-w-7xl items-end gap-6 px-4 pb-6 sm:px-6 sm:pb-8 lg:grid-cols-12 lg:gap-12 lg:px-8 lg:pb-12">
        <div class="hero-in lg:col-span-9">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-paper/80">{club.legalName}</p>
          <h1 class="display mt-4 text-[clamp(3rem,8vw,8.5rem)] [text-shadow:0_2px_24px_rgb(0_0_0/0.25)] [html[lang=ar]_&]:text-[clamp(2.5rem,5.5vw,5.5rem)] [html[lang=ar]_&]:leading-[1.15]">{t.heroTitle.split(/(?<=\.)\s+/).map((line) => <span class="block">{line}</span>)}</h1>
          <div class="pointer-events-auto mt-6 flex flex-wrap items-center gap-x-6 gap-y-4 lg:mt-8">
            <CtaButton href={l(lang, '/mitgliedschaft')}>{t.joinCta}</CtaButton>
            <p class="max-w-md text-base leading-relaxed text-paper/90 sm:text-[17px]">{t.heroText}</p>
          </div>
        </div>
        <div class="pointer-events-auto flex items-center justify-between gap-4 text-xs text-paper/85 lg:col-span-3 lg:flex-col lg:items-end">
          {heroSlides.length > 1 && (
            <span class="order-2 flex shrink-0 items-center gap-1 lg:order-1" data-hero-controls hidden>
              {heroSlides.map((s, i) => (
                <button
                  type="button"
                  data-hero-dot={i}
                  aria-label={s.shortName}
                  aria-current={i === 0 ? 'true' : 'false'}
                  class="nums display grid h-11 min-w-9 place-items-center px-1 text-2xl text-paper/60 transition-colors hover:text-paper aria-[current=true]:text-paper"
                >
                  <span class="border-b-[3px] border-transparent leading-none [[aria-current=true]>&]:border-club">{numerals[i] ?? i + 1}</span>
                </button>
              ))}
            </span>
          )}
          <span class="order-1 lg:order-2 lg:text-end" aria-live="off" data-hero-captions>
            {heroSlides.map((s, i) => (
              <a href={s.href} data-hero-caption hidden={i !== 0} class="hover:text-paper">
                <span class="font-semibold text-paper">{s.shortName}</span><span class="hidden sm:inline"> · </span><span class="block sm:inline">{s.league}</span>
              </a>
            ))}
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <dl class="mt-10 grid grid-cols-1 border-t border-ink sm:grid-cols-3 lg:mt-14">
    <div class="flex items-baseline justify-between gap-4 border-b border-line py-4 sm:block sm:border-b-0 sm:border-e sm:py-5 sm:pe-6">
      <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.factTraining}</dt>
      <dd class="text-end text-base font-semibold sm:mt-2 sm:text-start sm:text-lg">{t.factTrainingValue}</dd>
    </div>
    <div class="flex items-baseline justify-between gap-4 border-b border-line py-4 sm:block sm:border-b-0 sm:border-e sm:px-6 sm:py-5">
      <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.factGround}</dt>
      <dd class="text-end text-base font-semibold sm:mt-2 sm:text-start sm:text-lg">{club.ground.name}</dd>
    </div>
    <div class="flex items-baseline justify-between gap-4 py-4 sm:block sm:py-5 sm:ps-6">
      <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.factFee}</dt>
      <dd class="text-end text-base font-semibold sm:mt-2 sm:text-start sm:text-lg">{t.factFeeValue}</dd>
    </div>
  </dl>
  </div>
</section>

<!-- 2. Nächste Spiele, live von fussball.de -->
<section class="bg-card">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-section sm:px-6 lg:grid-cols-12 lg:gap-12 lg:px-8">
    <div class="reveal lg:col-span-4">
      <h2 class="display text-5xl sm:text-6xl">{t.fixturesHeading}</h2>
      <p class="mt-5 max-w-sm leading-relaxed text-ink-soft">{t.fixturesText}</p>
      <a href={club.fussballDeClubUrl} rel="noopener" target="_blank" class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-club hover:text-club-deep">
        {t.fixturesLink}
        <Icon name="external" size={16} />
      </a>
    </div>
    <div class="reveal lg:col-span-8">
      <!-- Reiter: Spielplan / Tabelle. Ohne JavaScript ist der Spielplan sichtbar. -->
      <div role="tablist" aria-label={t.fixturesHeading} class="flex gap-1 border-b border-ink" data-tabs>
        <button role="tab" type="button" id="tab-schedule" aria-controls="panel-schedule" aria-selected="true" class="display -mb-px min-h-12 border-b-[3px] border-club px-3 text-2xl transition-colors aria-[selected=false]:border-transparent aria-[selected=false]:text-ink-soft aria-[selected=false]:hover:text-ink">{t.tabSchedule}</button>
        <button role="tab" type="button" id="tab-table" aria-controls="panel-table" aria-selected="false" tabindex="-1" class="display -mb-px min-h-12 border-b-[3px] border-club px-3 text-2xl transition-colors aria-[selected=false]:border-transparent aria-[selected=false]:text-ink-soft aria-[selected=false]:hover:text-ink">{t.tabTable}</button>
      </div>
      <div id="panel-schedule" role="tabpanel" aria-labelledby="tab-schedule" tabindex="0">
        <div
          data-fixtures="next"
          data-query={query}
          data-built-at={fixtures.fetchedAt}
          data-labels={JSON.stringify(fx)}
          data-team-labels={JSON.stringify(teamLabels)}
        >
          {nextGames.length > 0 ? (
            <ul set:html={nextGames.map(({ slug, g }) => gameRow(g, fx, teamLabels[slug])).join('')} />
          ) : (
            <p class="border-b border-line py-8 text-sm text-ink-soft">{fx.unavailable}</p>
          )}
        </div>
      </div>
      <div id="panel-table" role="tabpanel" aria-labelledby="tab-table" tabindex="0" hidden>
        <div role="tablist" aria-label={t.teamsHeading} class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 py-4 sm:mx-0 sm:px-0" data-team-tabs>
          {leagueTeamList.map((tm, i) => (
            <button role="tab" type="button" id={`ttab-${tm.slug}`} aria-controls={`tpanel-${tm.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="min-h-11 shrink-0 rounded-full px-4 text-sm font-semibold ring-1 ring-line transition-colors aria-[selected=true]:bg-ink aria-[selected=true]:text-paper aria-[selected=true]:ring-ink">{tm.data.shortName}</button>
          ))}
        </div>
        {leagueTeamList.map((tm, i) => (
          <div id={`tpanel-${tm.slug}`} role="tabpanel" aria-labelledby={`ttab-${tm.slug}`} tabindex="0" hidden={i !== 0}>
            <!-- Liga der gewählten Mannschaft; wechselt mit dem Reiter, weil sie im Panel steht -->
            <p class="mb-3 text-sm"><span class="font-semibold">{leagueLabel(tm.data.league, lang)}</span>{fixtures.teams[tm.slug]?.table?.season && <span class="text-ink-soft"> · {fixtures.teams[tm.slug]?.table?.season}</span>}</p>
            <div data-fixtures="table" data-team={tm.slug} data-query={query} data-built-at={fixtures.fetchedAt} data-labels={JSON.stringify(fx)} set:html={leagueTable(fixtures.teams[tm.slug]?.table ?? null, fx)} />
            <a href={l(lang, `/mannschaften/${tm.slug}`)} class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-club hover:text-club-deep">{tm.data.name} <Icon name="arrow" size={16} /></a>
          </div>
        ))}
      </div>
      <p class="mt-3 text-xs text-ink-soft">{fx.source}</p>
    </div>
  </div>
</section>

<!-- 3. Mannschaften als Index, nicht als Kachelwand -->
<section class="mx-auto max-w-7xl px-4 py-section sm:px-6 lg:px-8">
  <div class="reveal flex items-end justify-between gap-6">
    <h2 class="display text-5xl sm:text-6xl">{t.teamsHeading}</h2>
    <a href={l(lang, '/mannschaften')} class="hidden min-h-11 items-center gap-2 text-sm font-semibold text-club hover:text-club-deep sm:inline-flex">{t.allTeams} <Icon name="arrow" size={16} /></a>
  </div>
  <ol class="stagger mt-10 border-t border-ink">
    {teams.map((team, i) => (
      <li class="border-b border-line">
        <a href={l(lang, `/mannschaften/${team.slug}`)} class="group grid grid-cols-[4rem_1fr_auto] items-center gap-4 py-3 sm:grid-cols-[4.5rem_1fr_1fr_auto] sm:gap-6 sm:py-4">
          <span class="overflow-hidden rounded-sm bg-ink">
            <img src={team.data.image} alt="" width="160" height="160" loading="lazy" class="aspect-square w-full object-cover transition-transform duration-500 ease-(--ease-club) group-hover:scale-105" style={`object-position: 50% ${team.data.imageFocus}%`} />
          </span>
          <span class="min-w-0">
            <span class="nums block text-xs font-semibold uppercase tracking-[0.14em] text-club">{numerals[i] ?? i + 1}</span>
            <span class="display mt-1 block text-3xl text-balance sm:truncate sm:text-4xl lg:text-5xl">{team.data.name}</span>
            <span class="mt-1 block text-sm text-ink-soft sm:hidden">{leagueLabel(team.data.league, lang)}</span>
          </span>
          <span class="hidden text-sm leading-relaxed sm:block">
            <span class="block font-semibold">{leagueLabel(team.data.league, lang)}</span>
            {team.data.training.map((slot) => <span class="block text-ink-soft">{trainingLabel(slot, lang)}</span>)}
          </span>
          <span class="flex h-11 w-11 items-center justify-center rounded-full text-ink ring-1 ring-line transition-colors duration-200 group-hover:bg-ink group-hover:text-paper">
            <Icon name="arrow" size={18} />
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>

<!-- 4. Das eine rote Band: Mitspielen -->
<section class="bg-club text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-section sm:px-6 lg:grid-cols-12 lg:gap-12 lg:px-8">
    <div class="reveal lg:col-span-6">
      <h2 class="display text-[clamp(3.25rem,9vw,6.5rem)]">{t.joinHeading}</h2>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-white/85">{t.joinText}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <CtaButton href={l(lang, '/probetraining')} variant="light">{t.trialCta}</CtaButton>
        <a href={l(lang, '/mitgliedschaft')} class="inline-flex min-h-12 items-center text-[15px] font-semibold underline decoration-white/40 decoration-2 underline-offset-[6px] hover:decoration-white">{t.nav.mitgliedschaft}</a>
      </div>
    </div>
    <ol class="stagger self-end lg:col-span-6">
      {t.joinSteps.map((step, i) => (
        <li class="flex items-baseline gap-6 border-t border-white/25 py-5 last:border-b">
          <span class="display nums w-10 shrink-0 text-4xl text-white/50">{i + 1}</span>
          <span class="text-lg font-medium leading-snug">{step}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- 5. News: ein Aufmacher, der Rest als Liste -->
{lead && (
  <section class="mx-auto max-w-7xl px-4 py-section sm:px-6 lg:px-8">
    <div class="reveal flex items-end justify-between gap-6">
      <h2 class="display text-5xl sm:text-6xl">{t.newsHeading}</h2>
      <a href={l(lang, '/news')} class="inline-flex min-h-11 shrink-0 items-center gap-2 whitespace-nowrap text-sm font-semibold text-club hover:text-club-deep">{t.allNews} <Icon name="arrow" size={16} /></a>
    </div>
    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-12">
      <a href={l(lang, `/news/${lead.slug}`)} class="reveal group lg:col-span-7">
        {lead.data.image && (
          <div class="overflow-hidden rounded-sm bg-ink">
            <img {...thumbAttrs(lead.data.image)} sizes="(min-width: 64rem) 42rem, 100vw" alt="" loading="lazy" class="aspect-[3/2] w-full object-cover transition-transform duration-700 ease-(--ease-club) group-hover:scale-[1.02]" />
          </div>
        )}
        <p class="mt-5 text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft"><span class="text-club">{lead.data.tag}</span> · <time datetime={lead.data.date.toISOString().slice(0, 10)}>{fmt(lead.data.date)}</time></p>
        <h3 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-balance group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4 sm:text-4xl">{lead.data.title}</h3>
        <p class="mt-3 max-w-xl leading-relaxed text-ink-soft">{lead.data.teaser}</p>
      </a>
      <ul class="stagger border-t border-ink lg:col-span-5">
        {moreNews.slice(0, 4).map((n) => (
          <li class="border-b border-line">
            <a href={l(lang, `/news/${n.slug}`)} class="group block py-6">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft"><span class="text-club">{n.data.tag}</span> · <time datetime={n.data.date.toISOString().slice(0, 10)}>{fmt(n.data.date)}</time></p>
              <h3 class="mt-2 text-xl font-bold leading-snug group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">{n.data.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-soft">{n.data.teaser}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<!-- 6. Chronik: 1925 als Zahl, die Wappen als Dokumente -->
<section class="border-y border-line bg-card">
  <div class="mx-auto max-w-7xl px-4 py-section sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
      <p class="reveal display nums text-[clamp(6rem,22vw,15rem)] leading-[0.8] text-club lg:col-span-6" aria-hidden="true">1925</p>
      <div class="reveal self-end lg:col-span-6">
        <h2 class="display text-4xl sm:text-5xl">{t.chronikHeading}</h2>
        <p class="mt-5 max-w-lg font-serif text-lg leading-relaxed text-ink-soft">{t.chronikText}</p>
        <a href={l(lang, '/vereinschronik')} class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-club hover:text-club-deep">{t.chronikCta} <Icon name="arrow" size={16} /></a>
      </div>
    </div>
    <ol class="no-scrollbar stagger -mx-4 mt-14 flex snap-x scroll-px-4 gap-4 overflow-x-auto px-4 sm:gap-px sm:mx-0 sm:grid sm:grid-cols-7 sm:overflow-visible sm:px-0">
      {chronik.map((c) => (
        <li class="w-32 shrink-0 snap-start border-t border-ink pt-4 sm:w-auto">
          <img src={c.img} alt="" width="64" height="64" loading="lazy" class="h-14 w-14 object-contain mix-blend-multiply" />
          <p class="display nums mt-4 text-2xl">{c.year}</p>
          <p class="mt-1 text-xs leading-snug text-ink-soft">{c.label}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- 7. Fanshop -->
<section class="mx-auto max-w-7xl px-4 py-section sm:px-6 lg:px-8">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="reveal lg:col-span-4">
      <h2 class="display text-5xl sm:text-6xl">{t.shopHeading}</h2>
      <p class="mt-5 max-w-sm leading-relaxed text-ink-soft">{t.shopText}</p>
      <CtaButton href={l(lang, '/shop')} class="mt-8">{t.shopCta}</CtaButton>
      <p class="mt-4 max-w-xs text-xs leading-relaxed text-ink-soft">{t.shopNote}</p>
    </div>
    <div class="lg:col-span-8">
      <ShopGrid limit={4} />
    </div>
  </div>
</section>

<!-- 8. Instagram, nur wenn echte Beiträge da sind -->
{socialIsLive && (
  <section class="mx-auto max-w-7xl px-4 pb-section sm:px-6 lg:px-8">
    <div class="reveal flex items-end justify-between gap-6 border-t border-ink pt-6">
      <h2 class="display text-3xl">Instagram</h2>
      <a href={club.social.instagram} rel="noopener" target="_blank" class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-club">@fc.treptow <Icon name="external" size={16} /></a>
    </div>
    <ul class="stagger mt-6 grid grid-cols-3 gap-1 sm:grid-cols-6">
      {socialPosts.map((post) => (
        <li>
          <a href={post.permalink} rel="noopener" target="_blank" class="block overflow-hidden rounded-sm">
            <Image src={post.imageUrl} alt={post.caption?.slice(0, 120) || 'Instagram'} width={400} height={400} class="aspect-square w-full object-cover" />
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<!-- 9. Partner: ruhig, eine Zeile -->
{sponsors.length > 0 && (
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal flex flex-col gap-8 border-t border-ink pt-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex items-baseline gap-6">
        <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">{t.sponsorsHeading}</h2>
        <a href={l(lang, '/sponsoren')} class="text-sm font-semibold text-club hover:text-club-deep">{t.becomePartner}</a>
      </div>
      <ul class="flex flex-wrap items-center gap-x-10 gap-y-6">
        {sponsors.map((s) => (
          <li>
            <a href={s.data.url ?? l(lang, '/sponsoren')} rel="noopener" class="flex min-h-11 items-center opacity-70 grayscale transition-[opacity,filter] duration-300 hover:opacity-100 hover:grayscale-0">
              {s.data.logo ? (
                <img src={s.data.logo} alt={s.data.name} loading="lazy" class="h-10 w-auto max-w-32 object-contain mix-blend-multiply" />
              ) : (
                <span class="display text-2xl">{s.data.name}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

