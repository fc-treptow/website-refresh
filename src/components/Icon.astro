---
// Eine Icon-Familie für die ganze Seite: feine Linien, 1.5px, runde Enden.
interface Props {
  name: 'home' | 'shirt' | 'news' | 'ball' | 'more' | 'arrow' | 'external' | 'close' | 'pin' | 'clock' | 'download' | 'bag' | 'mail' | 'phone' | 'globe' | 'chevron' | 'instagram' | 'facebook' | 'tiktok' | 'check' | 'lock' | 'play';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className = '' } = Astro.props;
const paths: Record<Props['name'], string> = {
  home: '<path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1v-9.5Z"/>',
  shirt: '<path d="M8.5 3.5 4 6l1.5 4.5L7.5 10v10.5h9V10l2 .5L20 6l-4.5-2.5c-.6 1.6-2 2.5-3.5 2.5s-2.9-.9-3.5-2.5Z"/>',
  news: '<path d="M5 4.5h11a1 1 0 0 1 1 1V19a1.5 1.5 0 0 0 3 0V9h-3"/><path d="M18.5 20.5H6A2 2 0 0 1 4 18.5v-14"/><path d="M7.5 8.5h6M7.5 12h6M7.5 15.5h4"/>',
  ball: '<circle cx="12" cy="12" r="8.5"/><path d="m12 7.5 3.8 2.8-1.5 4.4H9.7l-1.5-4.4L12 7.5Z"/><path d="M12 3.5v4M15.8 10.3l4.2-1.2M14.3 14.7l2.5 3.8M9.7 14.7l-2.5 3.8M8.2 10.3 4 9.1"/>',
  more: '<circle cx="6" cy="12" r="1.2" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/><circle cx="18" cy="12" r="1.2" fill="currentColor" stroke="none"/>',
  arrow: '<path d="M4.5 12h15M13.5 6l6 6-6 6"/>',
  external: '<path d="M8 16 16.5 7.5M9.5 7.5h7v7"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  download: '<path d="M12 4v11M7 10.5l5 5 5-5M5 19.5h14"/>',
  bag: '<path d="M5.5 8h13l-1 12.5h-11l-1-12.5Z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="m4 7 8 6 8-6"/>',
  phone: '<path d="M6.5 3.5h3l1.5 4.5-2 1.3a10 10 0 0 0 5.7 5.7l1.3-2 4.5 1.5v3a2 2 0 0 1-2 2A15.5 15.5 0 0 1 4.5 5.5a2 2 0 0 1 2-2Z"/>',
  globe: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.3 2.4 3.5 5.2 3.5 8.5s-1.2 6.1-3.5 8.5c-2.3-2.4-3.5-5.2-3.5-8.5s1.2-6.1 3.5-8.5Z"/>',
  chevron: '<path d="m7 10 5 5 5-5"/>',
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17" cy="7" r=".6" fill="currentColor"/>',
  facebook: '<path d="M14 8.5h2.5V5h-2.5A3.5 3.5 0 0 0 10.5 8.5V11H8v3.5h2.5V21H14v-6.5h2.5l.5-3.5h-3V9a.5.5 0 0 1 .5-.5Z"/>',
  tiktok: '<path d="M14 3.5v11a3.5 3.5 0 1 1-3-3.46"/><path d="M14 3.5c.4 2.7 2.3 4.5 5 4.7"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  play: '<rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="m10 9.2 5 2.8-5 2.8V9.2Z"/>',
  lock: '<rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>',
};
const flip = ['arrow'].includes(name) ? 'rtl:-scale-x-100' : '';
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={`shrink-0 ${flip} ${className}`}
  set:html={paths[name]}
/>
