---
import Base from '../../../layouts/Base.astro';
import Sections from '../../../components/sections/TeamDetailSections.astro';
import { getTeams, leagueLabel, teamTitle, trainingLabel } from '../../../i18n/content';

export async function getStaticPaths() {
  const teams = await getTeams('ar');
  return teams.map((team) => ({ params: { slug: team.slug }, props: { team } }));
}

const { team } = Astro.props;
const d = team.data;
const description = [`${d.name}, ${leagueLabel(d.league, 'ar')}`, ...d.training.map((s) => trainingLabel(s, 'ar'))].join('. ');
---
<Base title={teamTitle(d, 'ar')} description={description} image={d.image}>
  <Sections team={team} />
</Base>
