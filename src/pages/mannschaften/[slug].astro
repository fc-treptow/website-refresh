---
import Base from '../../layouts/Base.astro';
import Sections from '../../components/sections/TeamDetailSections.astro';
import { getTeams, leagueLabel, teamTitle, trainingLabel } from '../../i18n/content';

export async function getStaticPaths() {
  const teams = await getTeams('de');
  return teams.map((team) => ({ params: { slug: team.slug }, props: { team } }));
}

const { team } = Astro.props;
const d = team.data;
const description = [`${d.name}, ${leagueLabel(d.league, 'de')}`, ...d.training.map((s) => trainingLabel(s, 'de'))].join('. ');
---
<Base title={teamTitle(d, 'de')} description={description} image={d.image}>
  <Sections team={team} />
</Base>
