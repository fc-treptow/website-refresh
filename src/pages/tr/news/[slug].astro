---
import Base from '../../../layouts/Base.astro';
import Sections from '../../../components/sections/NewsDetailSections.astro';
import { getNews } from '../../../i18n/content';

export async function getStaticPaths() {
  const news = await getNews('tr');
  return news.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
---
<Base title={post.data.title} description={post.data.teaser} image={post.data.image} imageAlt={post.data.imageAlt ?? undefined} type="article" published={post.data.date} section={post.data.tag}>
  <Sections post={post} />
</Base>
